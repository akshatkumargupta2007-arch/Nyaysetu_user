# Copy to .env and fill in. Never commit the real .env file.

# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:dev@localhost:5432/nyaysetu

# ── Web ───────────────────────────────────────────────────────────
PUBLIC_WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8080
VITE_TURNSTILE_SITE_KEY=
# Google Maps JavaScript API browser key for the Where / Status screens. In Google Cloud, restrict it to your site's
# address (HTTP referrers: http://localhost:5173/*, http://localhost:5175/*, your real domain) and to the Maps JavaScript API only.
# Empty = the screens show the static map picture instead.
VITE_GOOGLE_MAPS_API_KEY=

# ── Gemini ────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_VISION=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# ── ElevenLabs ────────────────────────────────────────────────────
ELEVEN_API_KEY=
ELEVEN_STT_MODEL=
ELEVEN_TTS_MODEL=
ELEVEN_TTS_MODEL_FALLBACK=
ELEVEN_VOICE_ID_HI=
ELEVEN_VOICE_ID_EN=

# local dev: gemini (keeps Scribe credits for staging/prod) | prod: eleven
STT_PROVIDER=gemini
STT_DAILY_CAP=300

# ── Cloudinary ────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Security ──────────────────────────────────────────────────────
TURNSTILE_SECRET=
JWT_SECRET=change-me-to-a-long-random-string
PHONE_ENC_KEY=

# ── Demo mode ─────────────────────────────────────────────────────
DEMO_MODE=false
DEMO_KEY=change-me

# ── Observability ─────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info

# ── Server ────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
